<Window x:Class="TN.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Performance Analytics" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">
    
    <Border Background="#F1F5F9" CornerRadius="24" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
        <Grid>
            <!-- Sidebar / Header Area -->
            <Grid.RowDefinitions>
                <RowDefinition Height="180"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource HeaderNavy}" CornerRadius="24,24,0,0">
                <Grid Margin="40,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ANALYTICS DASHBOARD" FontSize="12" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Your Learning Progress" FontSize="32" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,-20,0">
                        <Button x:Name="btnBack" Content="←" 
                                Width="40" Height="40" Margin="0,0,10,0"
                                Foreground="White" FontSize="20" Background="Transparent" BorderThickness="0" 
                                Cursor="Hand" Click="btnBack_Click" ToolTip="Quay lại"/>
                        
                        <Button x:Name="btnClose" Content="✕" 
                                Width="40" Height="40"
                                Foreground="White" FontSize="18" Background="Transparent" BorderThickness="0" 
                                Cursor="Hand" Click="btnClose_Click" ToolTip="Thoát"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Dashboard -->
            <Grid Grid.Row="1" Margin="30,-40,30,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Chart & Mastery -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <!-- Summary Cards -->
                    <UniformGrid Columns="3" Height="100" Margin="0,0,0,20">
                        <Border Style="{StaticResource ModernCard}" Margin="0,0,10,0" Padding="15">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Total Exams" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="txtTotalExams" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ModernCard}" Margin="5,0,5,0" Padding="15">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Avg. Accuracy" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="txtAvgScore" Text="0%" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ModernCard}" Margin="10,0,0,0" Padding="15">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Study Streak" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="txtStreak" Text="0 Days" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Chart Card -->
                    <Border Style="{StaticResource ModernCard}" Height="350" Padding="25">
                        <Grid>
                            <TextBlock Text="WEEKLY PERFORMANCE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Top"/>
                            
                            <!-- Custom Chart Area -->
                            <ItemsControl x:Name="icChart" Margin="0,40,0,30" VerticalAlignment="Bottom">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Bottom" Height="220" Margin="5,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ValueText}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="{StaticResource TextSecondary}"/>
                                                <Border Width="40" Height="{Binding BarHeight}" Background="{Binding BarBrush}" CornerRadius="6,6,2,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="0.8"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Axis Label -->
                            <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" VerticalAlignment="Bottom" Margin="0,0,0,25"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Right Column: Details & Weakness -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource ModernCard}" Padding="20" Margin="0,40,0,15">
                        <StackPanel>
                            <TextBlock Text="WEAK TOPICS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DangerRed}" Margin="0,0,0,15"/>
                            <ItemsControl x:Name="icWeakTopics">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <TextBlock Text="{Binding TopicName}" FontWeight="SemiBold" HorizontalAlignment="Left" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ErrorCount, StringFormat={}{0} errors}" Foreground="{StaticResource DangerRed}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModernCard}" Padding="20" Background="{StaticResource AccentCyan}" Opacity="0.9">
                        <StackPanel>
                            <TextBlock Text="STUDY GOAL" Foreground="White" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="You're doing great! Focus on these weak topics to hit 100% accuracy." Foreground="White" TextWrapping="Wrap" Opacity="0.9"/>
                        </StackPanel>
                    </Border>
                    
                    <Button x:Name="btnExport" Content="EXPORT REPORT (PDF)" Height="50" Margin="0,20,0,0"
                            Background="{StaticResource HeaderNavy}" Foreground="White" FontWeight="Bold" 
                            BorderThickness="0" Cursor="Hand" Click="btnExport_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
