<Window x:Class="TN.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài Đặt Hệ Thống" Height="550" Width="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="#F4F7FA">
    
    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Background="#FFFFFF" Height="60">
                 <TextBlock Text="⚙️ TÙY CHỈNH HỆ THỐNG" FontWeight="Bold" FontSize="18" Foreground="#1E293B" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas"/>
            </Grid>

            <!-- CONTENT -->
            <StackPanel Grid.Row="1" Margin="40,20">
                
                <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <TextBlock Text="🔊 Âm thanh hệ thống" FontSize="14" Foreground="#334155" VerticalAlignment="Center"/>
                        <CheckBox x:Name="chkSound" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                    </Grid>
                </Border>

                <!-- PREMIUM ACTIVATION -->
                <Border Background="#FFFFFF" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="💎 BẢN QUYỀN HỆ THỐNG" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                            <Border x:Name="pnlStatus" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock x:Name="txtStatus" Text="FREE" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Mã máy của bạn (Hãy gửi mã này cho Admin):" FontSize="11" Foreground="#64748B" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtDeviceId" IsReadOnly="True" Background="#F8FAFC" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#E2E8F0"/>
                            <Button Grid.Column="1" Content="COPY" Width="60" Margin="5,0,0,0" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Click="BtnCopy_Click" Cursor="Hand"/>
                        </Grid>

                        <TextBlock Text="Nhập mã kích hoạt (License Key):" FontSize="11" Foreground="#64748B" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtLicenseKey" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#E2E8F0"/>
                            <Button x:Name="btnActivate" Grid.Column="1" Content="KÍCH HOẠT" Width="100" Margin="5,0,0,0" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnActivate_Click" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <TextBlock Text="Ghi chú: Bản quyền vĩnh viễn theo máy." FontSize="11" Foreground="#94A3B8" FontStyle="Italic"/>
                </StackPanel>
            </StackPanel>

            <!-- BUTTONS -->
            <Grid Grid.Row="2" Background="#FFFFFF" Height="70">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0">
                    <Button Content="Hủy bỏ" Width="100" Height="40" Margin="0,0,10,0" 
                            Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
                    <Button Content="Lưu Cài Đặt" Width="120" Height="40" 
                            Background="#0072B5" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
