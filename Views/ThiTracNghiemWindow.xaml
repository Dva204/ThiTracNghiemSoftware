<Window x:Class="TN.ThiTracNghiemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thi Trắc Nghiệm - Modern Learning" Height="850" Width="1400"
        WindowState="Maximized" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource AppBackground}" Loaded="OnLoaded">

    <Window.Resources>
        <!-- Answer Selection Card Style -->
        <Style x:Key="AnswerCardStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource BorderLight}" 
                                BorderThickness="1.5" CornerRadius="16" Padding="25,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="circle" Width="24" Height="24" CornerRadius="12" BorderBrush="{StaticResource AccentBlue}" BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Ellipse x:Name="dot" Width="12" Height="12" Fill="{StaticResource AccentBlue}" Visibility="Hidden"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="17"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                <Setter TargetName="bd" Property="Background" Value="#F0F9FF"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2.5"/>
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Question Pill Style -->
        <Style x:Key="QuestionPillStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#F1F5F9" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BorderLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource HeaderNavy}" Height="80">
            <Grid Margin="40,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnBack" Content="←" Click="btnBack_Click" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="24" Margin="0,0,20,0" Cursor="Hand"/>
                    <TextBlock Text="PRACTICE &amp; EXAM MODE" FontWeight="Bold" FontSize="18" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="pnlTimer" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="⏱" FontSize="24" Foreground="{StaticResource AccentCyan}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtTimer" Text="60:00" FontSize="32" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN LAYOUT -->
        <Grid Grid.Row="1" Margin="40,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: SETUP OR EXAM AREA -->
            <Grid Grid.Column="0" Margin="0,0,30,0">
                <!-- SETUP SCREEN -->
                <Border x:Name="pnlSetup" Style="{StaticResource ModernCard}" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock Text="EXAM CONFIGURATION" FontSize="26" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Select your bank and set the number of questions to start." Style="{StaticResource SubtitleSoft}" Margin="0,0,0,40"/>

                            <!-- Collection Selector -->
                            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,25" Padding="25">
                                <StackPanel>
                                    <TextBlock Text="1. SELECT QUESTION BANK" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,15"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="CATEGORY" FontSize="11" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="cboCategories" SelectionChanged="cboCategories_SelectionChanged" Height="45" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="SPECIFIC BANK" FontSize="11" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="cboQuestionBanks" SelectionChanged="cboQuestionBanks_SelectionChanged" Height="45" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Question Count & Time -->
                            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,40" Padding="25">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="2. QUESTION COUNT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,15"/>
                                        <TextBox x:Name="txtTotalQuestions" Text="40" Height="45" FontSize="16" VerticalContentAlignment="Center" Padding="15,0" BorderBrush="{StaticResource BorderLight}" TextChanged="OnSettingChanged">
                                            <TextBox.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="10"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                        <TextBlock x:Name="txtRangeInfo" Text="Available: 181" FontSize="11" Foreground="{StaticResource SuccessGreen}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="3. TIME LIMIT (MINUTES)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,15"/>
                                        <TextBox x:Name="txtTimeLimit" Text="60" Height="45" FontSize="16" VerticalContentAlignment="Center" Padding="15,0" BorderBrush="{StaticResource BorderLight}" TextChanged="OnSettingChanged">
                                            <TextBox.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="10"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel>
                                <UniformGrid Columns="2" Margin="0,0,0,15">
                                    <Button x:Name="btnStart" Content="START REAL EXAM" Height="60" Margin="0,0,10,0"
                                            Background="{StaticResource HeaderNavy}" Foreground="White" FontWeight="Bold" FontSize="16"
                                            Click="btnStart_Click" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="16"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button x:Name="btnPractice" Content="PRACTICE MODE" Height="60" Margin="10,0,0,0"
                                            Background="Transparent" BorderBrush="{StaticResource HeaderNavy}" BorderThickness="2"
                                            Foreground="{StaticResource HeaderNavy}" FontWeight="Bold" FontSize="16"
                                            Click="btnPractice_Click" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="16"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </UniformGrid>

                                <Grid>
                                    <Button x:Name="btnPracticeWrong" Content="SMART PRACTICE (WRONG QUESTIONS)" Height="60"
                                            Background="Transparent" BorderBrush="{StaticResource WarningOrange}" BorderThickness="2"
                                            Foreground="{StaticResource WarningOrange}" FontWeight="Bold" FontSize="16"
                                            Click="btnPracticeWrong_Click" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="16"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Border Background="#FFD700" CornerRadius="4" Padding="6,2" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-10,-10,0">
                                        <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="Black"/>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- Warning Panel -->
                            <StackPanel x:Name="pnlWarning" Visibility="Collapsed" Margin="0,20,0,0">
                                <Border Background="#1AF87171" CornerRadius="10" Padding="15">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠" Foreground="{StaticResource DangerRed}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtWarning" Text="Warning message goes here." Foreground="{StaticResource DangerRed}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- EXAM INTERFACE -->
                <Border x:Name="pnlExam" Style="{StaticResource ModernCard}" Visibility="Collapsed" Padding="40">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Main Exam Content (Scrollable) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
                            <StackPanel>
                                <!-- Question Header (Inside scroll to allow scrolling past large images) -->
                                <StackPanel Margin="0,0,0,30">
                                    <TextBlock x:Name="txtCurrentQIndex" Text="QUESTION 01" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="txtQuestion" Text="Question text..." 
                                               FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" LineHeight="32"/>

                                    <!-- Question Image -->
                                    <Border x:Name="pnlQuestionImage" Visibility="Collapsed" Margin="0,20,0,0" CornerRadius="12" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Background="White" Padding="10" HorizontalAlignment="Left">
                                        <Image x:Name="imgQuestion" MaxHeight="600" Stretch="Uniform"/>
                                    </Border>
                                </StackPanel>

                                <!-- Answer Area -->
                                <StackPanel x:Name="spAnswers">
                                    <RadioButton x:Name="rbA" Content="Option A" Style="{StaticResource AnswerCardStyle}" Checked="OnAnswerChecked"/>
                                    <RadioButton x:Name="rbB" Content="Option B" Style="{StaticResource AnswerCardStyle}" Checked="OnAnswerChecked"/>
                                    <RadioButton x:Name="rbC" Content="Option C" Style="{StaticResource AnswerCardStyle}" Checked="OnAnswerChecked"/>
                                    <RadioButton x:Name="rbD" Content="Option D" Style="{StaticResource AnswerCardStyle}" Checked="OnAnswerChecked"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Navigation Footer -->
                        <Grid Grid.Row="2" Margin="0,30,0,0">
                            <Button x:Name="btnPrev" Content="← PREVIOUS" HorizontalAlignment="Left" Padding="25,12" Background="#F1F5F9" FontWeight="Bold" Cursor="Hand" Click="btnPrev_Click"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="btnFlag" Content="⚑ FLAG FOR REVIEW" Background="Transparent" Foreground="{StaticResource WarningOrange}" FontWeight="Bold" BorderThickness="0" Margin="0,0,20,0" Cursor="Hand" Click="btnFlag_Click"/>
                                <Button x:Name="btnSubmit" Content="SUBMIT EXAM" Background="{StaticResource SuccessGreen}" Foreground="White" FontWeight="Bold" Padding="30,12" Cursor="Hand" Click="btnSubmit_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                            <Button x:Name="btnNext" Content="NEXT →" HorizontalAlignment="Right" Padding="25,12" Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="btnNext_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RESULT SCREEN -->
                <Border x:Name="pnlResult" Style="{StaticResource ModernCard}" Visibility="Collapsed" Padding="50">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="txtResultTitle" Text="EXAM COMPLETED" FontSize="14" Foreground="{StaticResource SuccessGreen}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="txtResultSub" Text="Your Final Performance" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                        
                        <UniformGrid Columns="2" Margin="0,0,0,40">
                             <StackPanel HorizontalAlignment="Center" Margin="0,0,20,0">
                                 <TextBlock Text="SCORE" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                 <TextBlock x:Name="txtFinalScore" Text="9.5" FontSize="64" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                             </StackPanel>
                             <StackPanel HorizontalAlignment="Center" Margin="20,0,0,0">
                                 <TextBlock Text="CORRECT ANSWERS" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                 <TextBlock x:Name="txtFinalCorrect" Text="38/40" FontSize="64" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                             </StackPanel>
                        </UniformGrid>

                        <Button x:Name="btnRetry" Content="BACK TO SETUP" Width="200" Height="50"
                                Background="{StaticResource HeaderNavy}" Foreground="White" FontWeight="Bold"
                                Click="btnRetry_Click" Cursor="Hand">
                             <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="12"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        
                        <ListBox x:Name="resultList" Height="300" Margin="0,30,0,0" BorderThickness="0" Background="Transparent"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT: NAVIGATOR & PROGRESS -->
            <StackPanel Grid.Column="1">
                <Border x:Name="pnlExamInfo" Style="{StaticResource ModernCard}" Margin="0,0,0,25" Padding="25">
                    <StackPanel>
                        <TextBlock Text="OVERALL PROGRESS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,15"/>
                        <ProgressBar x:Name="pbProgress" Value="45" Height="12" Margin="0,0,0,10" Foreground="{StaticResource SuccessGreen}" Background="#F1F5F9" BorderThickness="0">
                            <ProgressBar.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </ProgressBar.Resources>
                        </ProgressBar>
                        <Grid>
                            <TextBlock x:Name="txtProgress" Text="45% Complete" FontSize="13" Foreground="{StaticResource TextPrimary}" FontWeight="Bold"/>
                            <TextBlock x:Name="txtCount" Text="18 / 40 Questions" FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCard}" VerticalAlignment="Stretch" MinHeight="400">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="QUESTION NAVIGATOR" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,15"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="spPaging" HorizontalAlignment="Center">
                                <!-- Question pills generated here -->
                            </WrapPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Bottom Status Bar / Premium Nudge -->
        <Border x:Name="pnlFreeLimitHint" Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Height="28" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock Text="💡" Margin="0,0,5,0" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Text="Bản FREE giới hạn 60 câu. " Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="Nâng cấp PREMIUM" Foreground="#0072B5" FontWeight="Bold" FontSize="11" Cursor="Hand" TextDecorations="Underline" MouseLeftButtonDown="BtnUpgrade_Click" VerticalAlignment="Center"/>
                <TextBlock Text=" để mở khóa vĩnh viễn." Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
