<Window x:Class="TN.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Question Editor" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">
    
    <Border Background="#F8FAFC" CornerRadius="20" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="{StaticResource HeaderNavy}" CornerRadius="20,20,0,0">
                <Grid Margin="25,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnBack" Content="← HOME" Click="btnBack_Click" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0"/>
                        <Rectangle Width="1" Height="20" Fill="#475569" Margin="15,0"/>
                        <TextBlock Text="PRO EDITOR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Smart Question Builder" FontSize="18" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnClose" Content="✕" Width="40" Height="40" Foreground="White" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="btnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/> <!-- Sidebar: Question List -->
                    <ColumnDefinition Width="*"/>   <!-- Content: Question Form -->
                </Grid.ColumnDefinitions>

                <!-- Question List Sidebar -->
                <Border Grid.Column="0" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="15">
                            <TextBlock Text="COLLECTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cboCollections" Height="35" Margin="0,0,0,15" SelectionChanged="cboCollections_SelectionChanged"/>
                            
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cboBanks" Height="35" SelectionChanged="cboBanks_SelectionChanged"/>
                                <Button x:Name="btnNewBank" Content="+" Grid.Column="1" Width="35" Height="35" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource SuccessGreen}" Foreground="White" FontWeight="Bold" IsDefault="True"
                                        BorderThickness="0" Cursor="Hand" Click="btnNewBank_Click" ToolTip="Tạo bộ đề mới"/>
                            </Grid>

                            <TextBlock Text="DISPLAY NAME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtBankTitle" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="{StaticResource BorderLight}">
                                <TextBox.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>

                        <ListBox x:Name="lstQuestions" Grid.Row="1" BorderThickness="0" Margin="5" Padding="5" SelectionChanged="lstQuestions_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding Text}" MaxWidth="300" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button x:Name="btnAddQuestion" Grid.Row="2" Content="+ ADD NEW QUESTION" Margin="15" Height="45"
                                Background="{StaticResource AccentCyan}" Foreground="White" FontWeight="Bold" 
                                BorderThickness="0" Cursor="Hand" Click="btnAddQuestion_Click">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Question Editor Form -->
                <Border Grid.Column="1" Padding="30">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="pnlForm" Visibility="Hidden">
                            <TextBlock Text="QUESTION CONTENT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                            <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Background="White" Padding="10">
                                <TextBox x:Name="txtQuestion" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100" BorderThickness="0" FontSize="16"/>
                            </Border>

                            <StackPanel Margin="0,15,0,0">
                                <TextBlock Text="IMAGE (OPTIONAL)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Background="White" MinHeight="40" Padding="10,0">
                                        <TextBlock x:Name="txtImagePath" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12" Text="No image selected" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <Button x:Name="btnBrowseImage" Grid.Column="1" Content="BROWSE" Width="100" Height="40" Margin="10,0,0,0"
                                            Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnBrowseImage_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                                <Border x:Name="pnlImagePreview" Margin="0,10,0,0" Visibility="Collapsed" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="5" Background="White" MaxHeight="200">
                                    <Grid>
                                        <Image x:Name="imgPreview" MaxHeight="190" Stretch="Uniform"/>
                                        <Button x:Name="btnClearImage" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Width="24" Height="24" Margin="5" Background="#80000000" Foreground="White" BorderThickness="0" Cursor="Hand" Click="btnClearImage_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="OPTIONS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,25,0,15"/>
                            
                            <!-- Opt A -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <RadioButton x:Name="rbA" GroupName="Correct" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBox x:Name="txtA" Grid.Column="1" Height="40" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="{StaticResource BorderLight}" Tag="A"/>
                            </Grid>

                            <!-- Opt B -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <RadioButton x:Name="rbB" GroupName="Correct" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBox x:Name="txtB" Grid.Column="1" Height="40" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="{StaticResource BorderLight}" Tag="B"/>
                            </Grid>

                            <!-- Opt C -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <RadioButton x:Name="rbC" GroupName="Correct" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBox x:Name="txtC" Grid.Column="1" Height="40" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="{StaticResource BorderLight}" Tag="C"/>
                            </Grid>

                            <!-- Opt D -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <RadioButton x:Name="rbD" GroupName="Correct" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBox x:Name="txtD" Grid.Column="1" Height="40" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="{StaticResource BorderLight}" Tag="D"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                <Button x:Name="btnDeleteQuestion" Content="DELETE" Width="120" Height="45" Margin="0,0,15,0"
                                        Background="#FEE2E2" Foreground="{StaticResource DangerRed}" FontWeight="Bold" 
                                        BorderThickness="0" Cursor="Hand" Click="btnDeleteQuestion_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <StackPanel>
                                    <Button x:Name="btnSave" Content="SAVE CHANGES" Width="180" Height="45"
                                            Background="{StaticResource HeaderNavy}" Foreground="White" FontWeight="Bold" 
                                            BorderThickness="0" Cursor="Hand" Click="btnSave_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="10"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button x:Name="btnSaveExam" Content="SAVE EXAM &amp; FINISH" Width="180" Height="36" Margin="0,10,0,0"
                                            Background="#334155" Foreground="White" FontSize="11" 
                                            BorderThickness="0" Cursor="Hand" Click="btnBackToImport_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
