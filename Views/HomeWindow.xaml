<Window x:Class="TN.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home - Modern Learning Platform" Height="800" Width="1400"
        WindowState="Maximized" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">
    
    <Window.Resources>
        <!-- Nav Card Style -->
        <Style x:Key="FeatureCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Style="{StaticResource ModernCard}" Padding="30" CornerRadius="24">
                            <StackPanel>
                                <Border Width="70" Height="70" CornerRadius="20" Background="#F1F5F9" Margin="0,0,0,20">
                                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="txtTitle" Text="{TemplateBinding Tag}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                                <TextBlock x:Name="txtSub" Text="Explore the modules to improve your technical knowledge." FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                                <Border HorizontalAlignment="Left" Background="{StaticResource AccentBlue}" CornerRadius="12" Padding="20,10" Opacity="0.9">
                                    <TextBlock Text="GET STARTED →" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                <Setter TargetName="bd" Property="Background" Value="#FDFDFD"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniStatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
             <Grid Margin="40,0">
                 <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentBlue}" Margin="0,0,15,0">
                        <TextBlock Text="🎓" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PREMIUM EXAM HUB" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border x:Name="bdPremiumBadge" Background="#FFD700" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="#000000"/>
                    </Border>
                    <Button x:Name="btnActivate" Content="GO PREMIUM" Margin="15,0,0,0" 
                            Background="Transparent" BorderBrush="{StaticResource AccentCyan}" Foreground="{StaticResource AccentCyan}"
                            BorderThickness="1" Padding="10,4" Cursor="Hand" Click="btnActivate_Click" VerticalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                 </StackPanel>
                 
                 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                     <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="0,0,10,0" ToolTip="Settings" Click="BtnSettings_Click">
                         <TextBlock Text="⚙" FontSize="24" Foreground="{StaticResource TextSecondary}"/>
                     </Button>
                     <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" ToolTip="Close" Click="BtnClose_Click">
                         <TextBlock Text="✕" FontSize="24" Foreground="{StaticResource TextSecondary}"/>
                     </Button>
                 </StackPanel>
             </Grid>
        </Border>

        <!-- HERO BANNER + QUICK STATS -->
        <StackPanel Grid.Row="1" Margin="40,30,40,20">
            <!-- Hero Banner -->
            <Border CornerRadius="32" Padding="60,50" Margin="0,0,0,30">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#1E293B" Offset="0"/>
                        <GradientStop Color="#0F172A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Welcome back" FontSize="14" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="READY FOR YOUR NEXT GOAL?" Style="{StaticResource HeadingLarge}" Foreground="White" Margin="0,0,0,15"/>
                        <TextBlock Text="Track your progress and practice with our professional and smart technical question banks." 
                                   Style="{StaticResource SubtitleSoft}" Foreground="#94A3B8" MaxWidth="600" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Image HorizontalAlignment="Right" Width="200" Opacity="0.1" Source="https://cdn-icons-png.flaticon.com/512/2436/2436636.png"/>
                </Grid>
            </Border>

            <!-- Quick Stats -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Style="{StaticResource MiniStatCard}">
                    <StackPanel>
                        <TextBlock Text="Overall Accuracy" FontSize="12" Foreground="{StaticResource TextSecondary}" FontWeight="Bold"/>
                        <TextBlock x:Name="txtAccuracy" Text="85%" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource MiniStatCard}">
                    <StackPanel>
                        <TextBlock Text="Total Exams" FontSize="12" Foreground="{StaticResource TextSecondary}" FontWeight="Bold"/>
                        <TextBlock x:Name="txtTotalExams" Text="12" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MiniStatCard}">
                    <StackPanel>
                        <TextBlock Text="Questions Practiced" FontSize="12" Foreground="{StaticResource TextSecondary}" FontWeight="Bold"/>
                        <TextBlock x:Name="txtTotalQuestions" Text="482" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningOrange}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource MiniStatCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Study Streak (Days)" FontSize="12" Foreground="{StaticResource TextSecondary}" FontWeight="Bold"/>
                        <TextBlock x:Name="txtStreak" Text="5" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerRed}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- FEATURE NAV -->
        <Grid Grid.Row="2" Margin="30,0,30,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource FeatureCardStyle}" Tag="Exam &amp; Practice" Click="BtnStartExam_Click">
                <TextBlock Text="🎯" FontSize="32"/>
            </Button>

            <Button Grid.Column="1" Style="{StaticResource FeatureCardStyle}" Tag="Collection Manager" Click="BtnImport_Click">
                <TextBlock Text="📂" FontSize="32"/>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource FeatureCardStyle}" Tag="History &amp; Analytics" Click="BtnStatistics_Click">
                <TextBlock Text="📊" FontSize="32"/>
            </Button>
        </Grid>
    </Grid>
</Window>
