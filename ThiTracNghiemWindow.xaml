<Window x:Class="TN.ThiTracNghiemWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Thi Trắc Nghiệm - Hệ Thống Radar 36D6M1"
    WindowState="Maximized"
    WindowStyle="None"
    ResizeMode="NoResize"
    Background="#F0F4F8"
    KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- ═══════════════════════════════════════════ -->
        <!--              MÀU SẮC CHÍNH (SÁNG)           -->
        <!-- ═══════════════════════════════════════════ -->
        <SolidColorBrush x:Key="BgPrimary"     Color="#F0F4F8"/>
        <SolidColorBrush x:Key="BgCard"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgCardHover"   Color="#EEF2F7"/>
        <SolidColorBrush x:Key="AccentGreen"   Color="#00A86B"/>
        <SolidColorBrush x:Key="AccentBlue"    Color="#0072B5"/>
        <SolidColorBrush x:Key="AccentOrange"  Color="#E85D26"/>
        <SolidColorBrush x:Key="AccentYellow"  Color="#D4A000"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#1A2233"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#5A6A85"/>
        <SolidColorBrush x:Key="BorderColor"   Color="#C8D6E5"/>
        <SolidColorBrush x:Key="CorrectColor"  Color="#00A86B"/>
        <SolidColorBrush x:Key="WrongColor"    Color="#D62839"/>

        <!-- ═══════════════════════════════════════════ -->
        <!--           STYLE: NÚT BẮT ĐẦU THI            -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="BtnStartStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00A86B" Offset="0"/>
                        <GradientStop Color="#0072B5" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground"   Value="#FFFFFF"/>
            <Setter Property="FontSize"     Value="16"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="FontFamily"   Value="Consolas"/>
            <Setter Property="Height"       Value="52"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--        STYLE: NÚT NỘP BÀI (ĐỎ CAM)          -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="BtnSubmitStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E85D26" Offset="0"/>
                        <GradientStop Color="#D62839" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="Height"          Value="48"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--          STYLE: NÚT ĐIỀU HƯỚNG CÂU           -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="NavBtnStyle" TargetType="Button">
            <Setter Property="Width"           Value="36"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Margin"          Value="3"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#C8D6E5"/>
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="Foreground"      Value="#5A6A85"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"    Value="#EEF2F7"/>
                                <Setter TargetName="bd" Property="BorderBrush"   Value="#0072B5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--          STYLE: SLIDER HIỆN ĐẠI              -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#0072B5" CornerRadius="3" Height="6"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" Height="18"
                                                     Fill="#0072B5"
                                                     Stroke="#FFFFFF"
                                                     StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#C8D6E5" CornerRadius="3" Height="6"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--         STYLE: TEXTBOX HIỆN ĐẠI              -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="Foreground"      Value="#1A2233"/>
            <Setter Property="BorderBrush"     Value="#C8D6E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="Height"          Value="42"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--         STYLE: RADIO BUTTON ĐÁP ÁN           -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="AnswerRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground"      Value="#1A2233"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="Margin"          Value="0,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                            Background="#FFFFFF"
                            BorderBrush="#C8D6E5"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Ký tự A/B/C/D -->
                                <Border x:Name="letter"
                                    Grid.Column="0"
                                    Width="32" Height="32"
                                    CornerRadius="16"
                                    Background="#EEF2F7"
                                    Margin="0,0,14,0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                </Border>
                                <!-- Nội dung đáp án -->
                                <TextBlock x:Name="txt"
                                       Grid.Column="1"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#1A2233"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd"     Property="Background"   Value="#E8F4FF"/>
                                <Setter TargetName="bd"     Property="BorderBrush"  Value="#0072B5"/>
                                <Setter TargetName="letter" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0072B5" Offset="0"/>
                                            <GradientStop Color="#00A86B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="txt"    Property="Foreground"   Value="#1A2233"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"  Value="#F5F8FC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A0B4CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar đẹp -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#B0C4D8" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ════════════════════════════════════════════════════ -->
    <!--                  LAYOUT CHÍNH                        -->
    <!-- ════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ══════════════ HEADER ══════════════ -->
        <Border Grid.Row="0"
            Background="#FFFFFF"
            BorderBrush="#C8D6E5"
            BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Tên -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0072B5" Offset="0"/>
                                <GradientStop Color="#00A86B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="📡" FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="THI TRẮC NGHIỆM"
                               Foreground="#1A2233"
                               FontSize="15"
                               FontWeight="Bold"
                               FontFamily="Consolas"/>
                        <TextBlock Text="HỆ THỐNG RADAR 36D6M1"
                               Foreground="#5A6A85"
                               FontSize="10"
                               FontFamily="Consolas"/>
                    </StackPanel>
                </StackPanel>

                <!-- Thông tin bài thi (hiển thị khi đang thi) -->
                <StackPanel x:Name="pnlExamInfo"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <!-- Tiến độ -->
                    <Border Background="#F0F4F8" BorderBrush="#C8D6E5"
                        BorderThickness="1" CornerRadius="6"
                        Padding="16,8" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CÂU: " Foreground="#5A6A85"
                                   FontFamily="Consolas" FontSize="13"/>
                            <TextBlock x:Name="txtProgress"
                                   Text="0/40"
                                   Foreground="#0072B5"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <!-- Đã trả lời -->
                    <Border Background="#F0F4F8" BorderBrush="#C8D6E5"
                        BorderThickness="1" CornerRadius="6"
                        Padding="16,8" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ĐÃ LÀM: " Foreground="#5A6A85"
                                   FontFamily="Consolas" FontSize="13"/>
                            <TextBlock x:Name="txtAnswered"
                                   Text="0"
                                   Foreground="#00A86B"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Đồng hồ đếm ngược -->
                <Border x:Name="pnlTimer"
                    Grid.Column="2"
                    Background="#FFF8E1"
                    BorderBrush="#F0C040"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,0"
                    Margin="0,10,16,10"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏱ " Foreground="#C68A00" FontSize="16"/>
                        <TextBlock x:Name="txtTimer"
                               Text="60:00"
                               Foreground="#C68A00"
                               FontSize="20"
                               FontWeight="Bold"
                               FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

                <!-- Nút đóng -->
                <Button Grid.Column="3"
                    Width="40" Height="40"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnClose_Click"
                    ToolTip="Đóng (ESC)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                <TextBlock Text="✕"
                                       Foreground="#5A6A85"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#D62839"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════ CONTENT ══════════════ -->
        <Grid Grid.Row="1">

            <!-- ════ MÀN HÌNH 1: CÀI ĐẶT BÀI THI ════ -->
            <Grid x:Name="pnlSetup" Background="#F0F4F8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="500"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          MaxWidth="500"
                          HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,40,0,40">

                        <!-- Tiêu đề -->
                        <TextBlock Text="CÀI ĐẶT BÀI THI"
                               Foreground="#0072B5"
                               FontSize="13"
                               FontFamily="Consolas"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>
                        <TextBlock Text="Tùy chỉnh đề thi của bạn"
                               Foreground="#1A2233"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>
                        <TextBlock Text="Chọn tỉ lệ câu hỏi theo mức độ khó, tổng số câu và thời gian làm bài."
                               Foreground="#5A6A85"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,0,0,36"/>

                        <!-- ─── Card: Tổng số câu + Thời gian ─── -->
                        <Border Background="#FFFFFF"
                            BorderBrush="#C8D6E5"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="24"
                            Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tổng số câu -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TỔNG SỐ CÂU"
                                           Foreground="#5A6A85"
                                           FontSize="11"
                                           FontFamily="Consolas"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtTotalQuestions"
                                         Text="40"
                                         Style="{StaticResource ModernTextBox}"
                                         TextChanged="OnSettingChanged"/>
                                    <TextBlock Text="Tối đa 196 câu"
                                           Foreground="#5A6A85"
                                           FontSize="11"
                                           Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- Thời gian -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="THỜI GIAN (PHÚT)"
                                           Foreground="#5A6A85"
                                           FontSize="11"
                                           FontFamily="Consolas"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtTimeLimit"
                                         Text="60"
                                         Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Text="Khuyến nghị: 60 phút"
                                           Foreground="#5A6A85"
                                           FontSize="11"
                                           Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>


                        <!-- Cảnh báo khi tỉ lệ sai -->
                        <Border x:Name="pnlWarning"
                            Background="#FFF5F5"
                            BorderBrush="#D62839"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,16"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠  " Foreground="#D62839" FontSize="14"/>
                                <TextBlock x:Name="txtWarning"
                                       Foreground="#A01020"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Nút bắt đầu -->
                        <Button x:Name="btnStart"
                            Content="▶  BẮT ĐẦU THI"
                            Style="{StaticResource BtnStartStyle}"
                            Click="btnStartExam_Click"
                            Margin="0,8,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ════ MÀN HÌNH 2: ĐỀ THI ════ -->
            <Grid x:Name="pnlExam" Visibility="Collapsed" Background="#F0F4F8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Câu hỏi -->
                    <ColumnDefinition Width="280"/>
                    <!-- Panel phải: điều hướng -->
                </Grid.ColumnDefinitions>

                <!-- ─── Khu vực câu hỏi (trái) ─── -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              Padding="40,36,36,20">
                        <StackPanel>
                            <!-- Badge mức độ -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">

                                <Border Background="#F0F4F8"
                                    BorderBrush="#C8D6E5"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,4"
                                    Margin="8,0,0,0">
                                    <TextBlock x:Name="txtQuestionNumber"
                                           Text="Câu 1 / 40"
                                           Foreground="#5A6A85"
                                           FontSize="11"
                                           FontFamily="Consolas"/>
                                </Border>
                            </StackPanel>

                            <!-- Nội dung câu hỏi -->
                            <TextBlock x:Name="txtQuestion"
                                   Text=""
                                   Foreground="#1A2233"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   LineHeight="30"
                                   Margin="0,0,0,28"/>

                            <!-- Các đáp án -->
                            <RadioButton x:Name="rbA" GroupName="Answers"
                                     Style="{StaticResource AnswerRadioStyle}"
                                     Checked="Answer_Checked">
                                <RadioButton.Content>
                                    <TextBlock FontSize="14" Foreground="#5A6A85"
                                           FontFamily="Consolas" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="A"/>
                                </RadioButton.Content>
                            </RadioButton>
                            <RadioButton x:Name="rbB" GroupName="Answers"
                                     Style="{StaticResource AnswerRadioStyle}"
                                     Checked="Answer_Checked">
                                <RadioButton.Content>
                                    <TextBlock FontSize="14" Foreground="#5A6A85"
                                           FontFamily="Consolas" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="B"/>
                                </RadioButton.Content>
                            </RadioButton>
                            <RadioButton x:Name="rbC" GroupName="Answers"
                                     Style="{StaticResource AnswerRadioStyle}"
                                     Checked="Answer_Checked">
                                <RadioButton.Content>
                                    <TextBlock FontSize="14" Foreground="#5A6A85"
                                           FontFamily="Consolas" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="C"/>
                                </RadioButton.Content>
                            </RadioButton>
                            <RadioButton x:Name="rbD" GroupName="Answers"
                                     Style="{StaticResource AnswerRadioStyle}"
                                     Checked="Answer_Checked">
                                <RadioButton.Content>
                                    <TextBlock FontSize="14" Foreground="#5A6A85"
                                           FontFamily="Consolas" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="D"/>
                                </RadioButton.Content>
                            </RadioButton>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Thanh điều hướng dưới -->
                    <Border Grid.Row="1"
                        Background="#FFFFFF"
                        BorderBrush="#C8D6E5"
                        BorderThickness="0,1,0,0"
                        Padding="40,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnPrev"
                                Grid.Column="0"
                                Content="← TRƯỚC"
                                Width="130" Height="42"
                                Background="#F0F4F8"
                                Foreground="#5A6A85"
                                FontFamily="Consolas"
                                FontSize="13"
                                FontWeight="Bold"
                                BorderBrush="#C8D6E5"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="btnPrev_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#0072B5"/>
                                                <Setter TargetName="bd" Property="Background"  Value="#E8F4FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Progress bar -->
                            <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="20,0">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="txtProgressBar"
                                           Text="0 / 40 câu đã trả lời"
                                           Foreground="#5A6A85"
                                           FontSize="12"
                                           FontFamily="Consolas"/>
                                </Grid>
                                <Border Background="#C8D6E5" CornerRadius="3" Height="4">
                                    <Border x:Name="progressFill"
                                        Background="#0072B5"
                                        CornerRadius="3"
                                        HorizontalAlignment="Left"
                                        Width="0"/>
                                </Border>
                            </StackPanel>

                            <Button x:Name="btnNext"
                                Grid.Column="2"
                                Content="TIẾP →"
                                Width="130" Height="42"
                                FontFamily="Consolas"
                                FontSize="13"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="btnNext_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0072B5" Offset="0"/>
                                        <GradientStop Color="#00A86B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Foreground>
                                    <SolidColorBrush Color="#FFFFFF"/>
                                </Button.Foreground>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ─── Panel điều hướng (phải) ─── -->
                <Border Grid.Column="1"
                    Background="#FFFFFF"
                    BorderBrush="#C8D6E5"
                    BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header panel phải -->
                        <Border Grid.Row="0"
                            Padding="20,16"
                            BorderBrush="#C8D6E5"
                            BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="BẢNG CÂU HỎI"
                                       Foreground="#5A6A85"
                                       FontSize="11"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"/>
                                <!-- Chú thích -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Width="14" Height="14" CornerRadius="3"
                                        Background="#E8F4FF"
                                        BorderBrush="#0072B5" BorderThickness="1"
                                        Margin="0,0,8,0"/>
                                    <TextBlock Text="Đang xem" Foreground="#5A6A85" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Width="14" Height="14" CornerRadius="3"
                                        Background="#E8F8F0"
                                        BorderBrush="#00A86B" BorderThickness="1"
                                        Margin="0,0,8,0"/>
                                    <TextBlock Text="Đã trả lời" Foreground="#5A6A85" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" CornerRadius="3"
                                        Background="#FFFFFF"
                                        BorderBrush="#C8D6E5" BorderThickness="1"
                                        Margin="0,0,8,0"/>
                                    <TextBlock Text="Chưa làm" Foreground="#5A6A85" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Lưới số câu -->
                        <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="16">
                            <WrapPanel x:Name="wrapNavButtons"
                                   Orientation="Horizontal"/>
                        </ScrollViewer>

                        <!-- Nút nộp bài -->
                        <Border Grid.Row="2"
                            Padding="16"
                            BorderBrush="#C8D6E5"
                            BorderThickness="0,1,0,0">
                            <Button Content="NỘP BÀI"
                                Style="{StaticResource BtnSubmitStyle}"
                                Click="btnSubmit_Click"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ════ MÀN HÌNH 3: KẾT QUẢ ════ -->
            <Grid x:Name="pnlResult" Visibility="Collapsed" Background="#F0F4F8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="700"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,40,0,40">
                    <StackPanel>

                        <!-- Điểm số lớn -->
                        <Border Background="#FFFFFF"
                            BorderBrush="#C8D6E5"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="40"
                            Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="KẾT QUẢ BÀI THI"
                                           Foreground="#5A6A85"
                                           FontSize="12"
                                           FontFamily="Consolas"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>
                                    <TextBlock x:Name="txtResultTitle"
                                           Text="HOÀN THÀNH!"
                                           Foreground="#00A86B"
                                           FontSize="36"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>
                                    <TextBlock x:Name="txtResultSub"
                                           Text=""
                                           Foreground="#5A6A85"
                                           FontSize="14"
                                           TextWrapping="Wrap"/>
                                </StackPanel>
                                <!-- Điểm tròn -->
                                <Border Grid.Column="1"
                                    Width="120" Height="120"
                                    CornerRadius="60"
                                    Margin="20,0,0,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0072B5" Offset="0"/>
                                            <GradientStop Color="#00A86B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                        <TextBlock x:Name="txtScore"
                                               Text="0"
                                               Foreground="#FFFFFF"
                                               FontSize="38"
                                               FontWeight="Bold"
                                               FontFamily="Consolas"
                                               HorizontalAlignment="Center"/>
                                        <TextBlock Text="ĐIỂM"
                                               Foreground="#FFFFFF"
                                               FontSize="11"
                                               FontFamily="Consolas"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Thống kê -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FFFFFF"
                                BorderBrush="#C8D6E5" BorderThickness="1"
                                CornerRadius="10" Padding="20">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtCorrectCount"
                                           Text="0" Foreground="#00A86B"
                                           FontSize="32" FontWeight="Bold"
                                           FontFamily="Consolas"
                                           HorizontalAlignment="Center"/>
                                    <TextBlock Text="Câu đúng" Foreground="#5A6A85"
                                           FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#FFFFFF"
                                BorderBrush="#C8D6E5" BorderThickness="1"
                                CornerRadius="10" Padding="20">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtWrongCount"
                                           Text="0" Foreground="#D62839"
                                           FontSize="32" FontWeight="Bold"
                                           FontFamily="Consolas"
                                           HorizontalAlignment="Center"/>
                                    <TextBlock Text="Câu sai" Foreground="#5A6A85"
                                           FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="#FFFFFF"
                                BorderBrush="#C8D6E5" BorderThickness="1"
                                CornerRadius="10" Padding="20">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtSkipCount"
                                           Text="0" Foreground="#D4A000"
                                           FontSize="32" FontWeight="Bold"
                                           FontFamily="Consolas"
                                           HorizontalAlignment="Center"/>
                                    <TextBlock Text="Bỏ qua" Foreground="#5A6A85"
                                           FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Chi tiết từng câu -->
                        <Border Background="#FFFFFF"
                            BorderBrush="#C8D6E5"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="24"
                            Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="CHI TIẾT KẾT QUẢ"
                                       Foreground="#5A6A85"
                                       FontSize="11"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       Margin="0,0,0,16"/>
                                <ItemsControl x:Name="resultList"/>
                            </StackPanel>
                        </Border>

                        <!-- Nút thi lại -->
                        <Button Content="↺  THI LẠI"
                            Style="{StaticResource BtnStartStyle}"
                            Click="btnRetry_Click"
                            Height="52"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</Window>
